    string data_sha256
    string git_commit
    text metrics_json
    text artifact_path
    string artifact_sha256
  }
  PREDICTION_LOG {
    int prediction_id PK
    datetime created_at
    string run_id
    string tier
    string team_a_id FK
    string team_b_id FK
    string venue_id FK
    string stage
    text toss_json
    float p_a "CHECK 0..1"
