    float second_innings_runs
    string winner_id FK
    string super_over_winner_id FK
    string result_type "CHECK complete|tie|no result"
    string margin_type
    float margin_value
    bool dls_flag
    bool voided
    bool team1_home
    bool team2_home
    int potm_player_id FK
    int referee_id FK
    int umpire1_id FK
    int umpire2_id FK
