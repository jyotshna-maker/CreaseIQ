%% D9 ER diagram (from src/creaseiq/db/models.py)
erDiagram
  FRANCHISE ||--o{ TEAM_ALIAS : "is known as"
  FRANCHISE ||--o{ MATCH : "team1 / team2 / toss / bat first / winner"
  FRANCHISE ||--o{ SEASON : "champion of"
  SEASON ||--o{ MATCH : contains
  VENUE ||--o{ MATCH : hosts
  MATCH ||--o{ MATCH_PLAYER : lists
  PLAYER ||--o{ MATCH_PLAYER : "plays in"
  FRANCHISE ||--o{ MATCH_PLAYER : "for"
  PLAYER |o--o{ MATCH : "player of the match"
  OFFICIAL |o--o{ MATCH : "referee / umpires"
  FRANCHISE ||--o{ PREDICTION_LOG : "team A / B"
  VENUE ||--o{ PREDICTION_LOG : at
  FRANCHISE {
    string franchise_id PK
    string canonical_name UK
    string short_code
    bool active
    text lineage_note
  }
  TEAM_ALIAS {
    string alias PK
    string franchise_id FK
    int valid_from_year
    int valid_to_year
  }
  VENUE {
    string venue_id PK
    string canonical_name UK
    string city
    string country
  }
  SEASON {
    int season_id PK
    int season_year UK
    string raw_label
    text host_note
    int n_matches
    string champion_id FK
  }
  PLAYER {
    int player_id PK
    string name UK
  }
  OFFICIAL {
    int official_id PK
    string name UK
  }
  MATCH {
    int match_id PK
    int season_id FK
    date date
    int match_number
    string stage
    string venue_id FK
    string team1_id FK
    string team2_id FK
    string toss_winner_id FK
